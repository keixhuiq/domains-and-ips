{
  "version": 3,
  "rules": [
    {
      "domain_keyword": [
        "stun"
      ],
      "domain_regex": [
        "(^|\\.)turn[0-9]*\\."
      ],
      "domain_suffix": [
        "autodesk.com",
        "autocad.com",
        "autodesk.net",
        "autodesk360.com",
        "autodesksketchbook.com"
      ]
    }
  ]
}
